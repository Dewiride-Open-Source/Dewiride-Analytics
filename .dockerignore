# Everything a build does not need. A smaller context is a faster build, and it keeps local
# working files — including .env — out of any image layer.

.git
.github
.vs
.vscode
.idea

**/bin
**/obj
**/node_modules
**/.next
**/coverage
**/TestResults
**/*.user

.env
.env.*
!.env.example

# The dashboard image compiles the tracker as well, because it is the dashboard that serves the
# beacon: one address for the snippet somebody pastes into their website.

# Not needed by either image.
integrations
tools
infra
deploy
docs
ee

**/Dockerfile
.dockerignore
compose.yaml
compose.override.yaml
