# Copy this file to .env and set your own passwords before starting anything.
#
#   cp .env.example .env
#
# .env is ignored by git and must stay that way. The placeholders below are not usable values:
# the stack refuses to start until the two passwords are set, which is deliberate — a working
# default password is a default password somebody ships.

# ---------------------------------------------------------------------------
# Keeping the settings somewhere else (optional)
# ---------------------------------------------------------------------------
# An Azure Key Vault to read the settings from, instead of keeping them in this file. Naming one
# makes it the last place settings are read from, so anything kept in it wins over the same
# setting written here.
#
# The reason to want it: a password or an API key can then be changed where it is stored, with a
# record of who changed it and when, by somebody who never opens a terminal on this machine — and
# this machine holds only the one credential that opens the vault, instead of holding every key.
#
# Secret names in a vault may only contain letters, digits and dashes, so where a setting here has
# a double underscore, the vault uses two dashes: Dewiride__Email__Password is stored there as
# Dewiride--Email--Password.
#
# The vault is read once, while the engine starts. Change something in it and restart the engine
# for the change to take effect. Naming a vault the engine cannot reach stops it starting, rather
# than starting it with everything the vault holds silently missing.
#
# Leave all four empty, which is the ordinary case, and only this file is read.
KEY_VAULT_ADDRESS=
KEY_VAULT_TENANT_ID=
KEY_VAULT_CLIENT_ID=
KEY_VAULT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL — organisations, websites, people, settings
# ---------------------------------------------------------------------------
POSTGRES_USER=dewiride
POSTGRES_PASSWORD=
POSTGRES_DB=dewiride_analytics
POSTGRES_PORT=5432

# Which of this machine's addresses the database answers on. Loopback means this machine and
# nothing else, which is what a stack whose every part runs here needs. Widening it puts the
# database on the internet on a rented server: Docker publishes a port by writing its own rules
# ahead of the host firewall's, so ufw and firewalld do not hold it back.
POSTGRES_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# ClickHouse — the traffic itself
# ---------------------------------------------------------------------------
CLICKHOUSE_USER=dewiride
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=dewiride_telemetry
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# As above, and it matters more here: this store holds every visit ever recorded, and it names
# itself and its version to anyone who asks before checking any password.
CLICKHOUSE_BIND=127.0.0.1

# How much memory ClickHouse may use. It sizes its caches against this figure, so lowering it is
# the way to make the stack fit a smaller machine.
CLICKHOUSE_MEMORY=2g

# ---------------------------------------------------------------------------
# The product itself
# ---------------------------------------------------------------------------
# Where the screens open in your browser.
WEB_PORT=3000

# Which of this machine's addresses the screens answer on. Loopback is right when a reverse proxy
# on this machine terminates TLS and forwards to them, which is how the product is meant to be
# published — signing in sets a cookie the browser only sends back over the connection that set
# it, so serving these screens unencrypted puts the dashboard's password on the wire. Set this to
# 0.0.0.0 only when the proxy runs on a different machine.
WEB_BIND=127.0.0.1

# Where the engine answers, on this machine only. The screens forward everything to it, so this is
# for looking at directly rather than something anything depends on.
API_PORT=8080

# Where your own website answers, if you want one at the same address as the product.
#
# The screens all sit under /app and nothing occupies the root, so anything you name here is
# forwarded whatever address is asked for that is not a screen — your front page, your writing,
# your robots file. It has to be reachable from this stack's network, so a container on it
# (http://mysite:3000) or an address on this machine (http://host.docker.internal:8080).
#
# Leave it empty, which is the ordinary case, and the root simply leads to the dashboard.
SITE_ORIGIN=

# The network the screens reach the engine over. Everything a browser sends passes through them
# first, so this is what lets the engine see the visitor's own address instead of the one next
# door. The default covers the network Docker creates for this stack. Put a load balancer or a
# content network in front of the whole thing and its address ranges belong here too.
TRUSTED_PROXY_NETWORK=172.16.0.0/12

# Whether to fetch the data that turns a visitor's address into a country, a town and a network
# operator. It is about 120 MB, it is republished monthly, and it is downloaded in the background
# after the product has started — so nothing waits on it and traffic is counted throughout.
#
# Set this to false on a machine with no way out to the internet. Put the files in the
# reference-data volume yourself and everything works the same; leave it empty and visitors are
# still counted, with their country shown honestly as not known.
REFERENCE_DATA_AUTO_DOWNLOAD=true

# Whether to fetch the lists of crawler addresses each company publishes for its own crawlers.
# These are what let the product say a visit really was Google or Microsoft, rather than only that
# it said so — a claim anybody can copy into a browser setting. They are a few hundred kilobytes in
# total and are checked twice a day.
#
# Set this to false on a machine with no way out to the internet. Traffic is still measured and
# crawlers are still recognised by the name they give, and every one of them reads as a claim
# rather than as a confirmed identity.
CRAWLER_RANGES_AUTO_DOWNLOAD=true

# Whether to ask a name server whose crawler a visit's address belongs to. Several companies —
# Yandex and Baidu among them — publish no list of addresses at all, and instead publish a domain
# their machines answer to; this is the only way those crawlers can ever be told apart from
# something using their name. The question is asked after a visit has ended, never while somebody
# is waiting for a page, and only about visits that already look like machinery — a visit that
# looks like somebody reading is never asked about, so a reader's address is never sent anywhere.
#
# Set this to false to keep every address inside the building. Traffic is still measured, and
# companies that publish a list of addresses are still confirmed from it.
CRAWLER_NAME_CHECKS=true

# How much the engine writes about what it is doing. Set this to Debug while working out why a
# website that has the tracking code on it is not showing any traffic: every report the engine
# turns away then says which address it came from and which address the website is registered as.
# Put it back to Information afterwards — the collector answers anybody, so a line per refused
# report is a log whose size is decided by whoever is scanning the internet that day.
ENGINE_LOG_LEVEL=Information

# ---------------------------------------------------------------------------
# Sending email
# ---------------------------------------------------------------------------
# The whole address people open the dashboard on, including https://. Every link this product
# sends — resetting a password, confirming an address — is built from it.
#
# It is written here rather than worked out from whoever asks, and that is on purpose: the address
# in an incoming request is chosen by whoever sent it, so a reset link built that way could be
# pointed at somebody else's server and the person clicking it would have no way to tell.
#
# Leave it empty if you are not sending mail. Fill it in before you switch mail on: the product
# refuses to start with one set and not the other, rather than sending links that go nowhere.
PUBLIC_URL=

# Whether to hand messages to a mail server at all. Left off, a message is written to the engine's
# log instead — which is how somebody who has forgotten the password to their own installation can
# still get back in without running a mail server. Anyone who can read that log can use the links
# in it, so switch this on before other people have accounts here.
EMAIL_ENABLED=false

# Your mail server, and the account to send through. Almost every provider uses port 587; a few
# offer 465 instead, which needs SMTP_SECURITY set to SslOnConnect. Use None only for a relay
# running on this same machine.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=

# What people see the message came from. The address has to be one your mail server will let you
# send as, or it will be refused or filed as spam.
#
# Quote anything containing a space. The backup and restore scripts read this file as shell, so an
# unquoted value with a space in it stops them before they copy anything — from a timer, silently.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Dewiride Analytics"

# Only needed if you run the product from source instead of in a container. Started with
# docker compose, it works these out from the settings above and reaches each store by name.
ConnectionStrings__ControlPlane="Host=localhost;Port=5432;Database=dewiride_analytics;Username=dewiride;Password="
ConnectionStrings__Telemetry="Host=localhost;Port=8123;Protocol=http;Database=dewiride_telemetry;Username=dewiride;Password="
