<Project>

  <!--
    Repository-wide build settings. Every project in backend/ and ee/ inherits these.
    Overriding any of the quality settings below in a leaf project requires a comment
    explaining why; the SonarQube gate treats them as non-negotiable.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Quality gate">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Reproducibility">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation>false</EnablePackageValidation>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <PropertyGroup Label="Assembly identity">
    <Company>Dewiride Technologies</Company>
    <Product>Dewiride Analytics</Product>
    <Copyright>Copyright (c) 2026 Dewiride Technologies</Copyright>
    <RepositoryUrl>https://github.com/Dewiride-Open-Source/Dewiride-Analytics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Edition switch. `Community` compiles the AGPL open-source product only; `Cloud`
    additionally compiles the commercially-licensed projects under ee/. Every ee/
    ProjectReference is conditioned on this property, so which edition you get is decided
    by which projects were compiled — never by a preprocessor branch. Roslyn analyzers and
    SonarQube do not analyse an inactive #if branch, so `#if EE` would push half the code
    outside a gate this repository treats as non-negotiable.

    ee/ is not part of this repository. It is a separate private repository checked out into
    ./ee, which is why that path is ignored here: what the commercial edition adds is
    cross-customer analysis that only exists because the hosted service sees many customers
    at once, and it is the one part of this product a competitor could not derive from the
    free code. A Cloud build without it fails on a missing project rather than quietly
    producing something that calls itself Cloud.
  -->
  <PropertyGroup Label="Edition">
    <DewirideEdition Condition="'$(DewirideEdition)' == ''">Community</DewirideEdition>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DewirideEdition)' != 'Community' AND '$(DewirideEdition)' != 'Cloud'">
    <_DewirideEditionInvalid>true</_DewirideEditionInvalid>
  </PropertyGroup>

  <Target Name="ValidateDewirideEdition" BeforeTargets="PrepareForBuild" Condition="'$(_DewirideEditionInvalid)' == 'true'">
    <Error Code="DEW0001"
           Text="DewirideEdition must be 'Community' or 'Cloud', but was '$(DewirideEdition)'." />
  </Target>

  <!--
    The commercial edition depends on one package that is not on any public feed, because it is
    ours and is not offered to anybody else: the client for the mail service the hosted service
    sends through. It ships as files inside ee/, and this points restore at them.

    Conditioned on the edition rather than written into a NuGet.config, and that is the whole
    point: a config file at this level names the folder for every restore, and an ordinary
    checkout — which has no ee/ — then fails on a source that does not exist. A Cloud build
    already requires ee/ to be present, so this is only ever read when the folder is there.

    Applied to every project rather than to the one that declares the reference, because restore
    resolves the whole graph: the host and the test projects pull it transitively and would
    otherwise be looking for it on nuget.org.
  -->
  <PropertyGroup Condition="'$(DewirideEdition)' == 'Cloud'">
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)ee/packages;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup Label="Analyzers applied to every project">
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup Label="Banned API list">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
  </ItemGroup>

</Project>
