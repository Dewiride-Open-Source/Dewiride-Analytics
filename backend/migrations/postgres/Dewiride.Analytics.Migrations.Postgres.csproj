<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The control plane's schema history. Migrations live here rather than beside the code they
    describe so that the two migration systems this product runs are visible side by side:
    ordered .sql files for the telemetry store sit in ../clickhouse. They are never interleaved
    and never share a history table.

    Everything in Migrations/ is generated by `dotnet ef migrations add` and is treated as
    generated code by .editorconfig, so hand-written style rules do not apply to it. Migrations
    are forward-only: once a file here has shipped, it is never edited, because a self-hoster has
    already run it.
  -->

  <PropertyGroup>
    <RootNamespace>Dewiride.Analytics.Migrations.Postgres</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dewiride.Analytics.Infrastructure\Dewiride.Analytics.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Compile assets are needed here, unlike everywhere else this package appears: the
      design-time factory below implements one of its interfaces. PrivateAssets keeps it from
      flowing on to the host.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
