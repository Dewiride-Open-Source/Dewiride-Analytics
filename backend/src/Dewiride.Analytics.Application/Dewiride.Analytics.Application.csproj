<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dewiride.Analytics.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dewiride.Analytics.Domain\Dewiride.Analytics.Domain.csproj" />
    <ProjectReference Include="..\Dewiride.Analytics.Classification\Dewiride.Analytics.Classification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!--
    TenantScope carries the authorisation decision that every telemetry query is bound to,
    so it must not be constructible by arbitrary code that merely holds a site identifier.
    Its constructor is internal and only the assemblies that implement ITenantScopeProvider
    can reach it. Widening this list is a security decision, not a convenience one.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Dewiride.Analytics.Infrastructure" />
    <InternalsVisibleTo Include="Dewiride.Analytics.Ee.Infrastructure" />
    <InternalsVisibleTo Include="Dewiride.Analytics.Application.Tests" />
    <InternalsVisibleTo Include="Dewiride.Analytics.SqlTests" />
    <InternalsVisibleTo Include="Dewiride.Analytics.Integration.Tests" />
  </ItemGroup>

</Project>
