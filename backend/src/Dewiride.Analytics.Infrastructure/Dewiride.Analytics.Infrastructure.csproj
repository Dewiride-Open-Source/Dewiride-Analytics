<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dewiride.Analytics.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dewiride.Analytics.Application\Dewiride.Analytics.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!--
      Hands messages to a mail server. The framework's own client is not recommended for new work
      and MailKit is the alternative Microsoft names; see Directory.Packages.props.
    -->
    <PackageReference Include="MailKit" />
    <!--
      Reads the MaxMind DB binary format, which is what DB-IP publishes its free geolocation data
      in. The reader only: no database ships with this product, and none of MaxMind's own are used.
    -->
    <PackageReference Include="MaxMind.Db" />
  </ItemGroup>

  <!--
    The readers of downloaded data are internal because nothing outside this assembly should reach
    a fetched file directly — the rest of the product asks INetworkLookup and
    ICrawlerAddressDirectory. Their own tests are the exception: what is worth pinning about them
    is how they cope with files somebody else's server produced, which cannot be asked through a
    port.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Dewiride.Analytics.Integration.Tests" />
    <!--
      The messages this product sends are internal because nothing outside composes one, and what
      they say is worth approving in review. Their tests render them and nothing else.
    -->
    <InternalsVisibleTo Include="Dewiride.Analytics.MailTests" />
  </ItemGroup>

</Project>
