<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests over the host's own composition — the settings it reads before anything is built,
    and what it refuses to start on. No container, no network and no vault.

    The suite that boots against real servers cannot cover this: everything here is about an
    engine that declines to boot, which that suite can only observe as a fixture failing to come
    up with no explanation attached.
  -->

  <PropertyGroup>
    <RootNamespace>Dewiride.Analytics.Api.Tests</RootNamespace>
    <AssemblyName>Dewiride.Analytics.Api.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dewiride.Analytics.Api\Dewiride.Analytics.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The dashboard's own list of the screens it serves, linked in rather than transcribed, so the
      test that holds the engine's list to it reads the file the dashboard is actually built from.
      A copy would agree with the engine on the day it was written and never again.
    -->
    <None Include="..\..\..\frontend\apps\web\src\lib\routes.ts"
          Link="routes.ts"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
